rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    function isRole(r) {
      return signedIn() && role() == r;
    }
    function isStaffOrAbove() {
      return signedIn() && role() in ['staff', 'chef', 'manager'];
    }

    match /outlets/{outletId} {
      allow read: if signedIn();
      allow write: if isRole('manager');
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaffOrAbove());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isRole('manager'));
    }

    match /menuItems/{id} {
      allow read: if signedIn();
      allow write: if isRole('manager');
    }

    match /slots/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /orders/{id} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid || isStaffOrAbove()
      );
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.studentId == request.auth.uid || isStaffOrAbove()
      );
    }

    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.studentId == request.auth.uid || isRole('manager'));
    }

    match /dailyStats/{id} {
      allow read: if signedIn();
      allow write: if isRole('manager') || isRole('chef');
    }
  }
}
